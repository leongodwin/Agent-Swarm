{
  "name": "cubefarm",
  "version": "0.3.2",
  "description": "A cartoon 3D office where a team of AI coding agents works through your GitHub issues.",
  "keywords": [
    "codex",
    "opencode",
    "gemini",
    "ai-agents",
    "coding-agents",
    "github-issues",
    "automation",
    "threejs"
  ],
  "homepage": "https://github.com/leonvanzyl/cubefarm#readme",
  "bugs": "https://github.com/leonvanzyl/cubefarm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonvanzyl/cubefarm.git"
  },
  "license": "MIT",
  "author": "Leon Godwin",
  "type": "module",
  "bin": {
    "cubefarm": "bin/cubefarm.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "docs/DELIVERY.md",
    "docs/RELIABILITY.md",
    "docs/WORKER-READINESS.md",
    "docs/APPLICATION-SPECIFICATION.md",
    "docs/TASK-EXECUTION.md",
    "docs/FIRST-SLICE.md",
    "docs/QUALITY-EVIDENCE.md",
    "docs/EXECUTION-EFFICIENCY.md",
    "docs/NATIVE-USAGE.md",
    "docs/GEMINI-LIVE-QA.md",
    "docs/LIVE-USAGE-GAPS-QA.md",
    "docs/SERVER-RESTART-SCHEDULER-QA.md",
    "docs/FULL-LAUNCHER-RECOVERY-QA.md",
    "docs/DELIVERY-LEASE-RESUMPTION-QA.md",
    "docs/RETAINED-CLOUD-RECONCILIATION-QA.md",
    "docs/NATIVE-TARGET-RECONCILIATION-QA.md",
    "docs/NATIVE-LEASE-HANDOFF-QA.md",
    "docs/TRACKED-IMPORT-ADOPTION-QA.md",
    "docs/PINNED-PREPARATION-RECOVERY-QA.md",
    "docs/AGENT-SWARM-M365-E2E-QA.md",
    "docs/PREREQUISITE-READINESS-QA.md",
    "docs/SHAREPOINT-PROVISIONING-QA.md",
    "docs/WORKER-CONTRACT-QA.md",
    "docs/PLANNING-CONTRACTS-QA.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/office.mjs --dev",
    "demo": "node scripts/office.mjs --dev --demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-server.mjs",
    "start": "node scripts/office.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@azure/msal-node": "7.1.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/mcp": "0.0.83",
    "@react-three/postprocessing": "^3.1.3",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "5.11.2",
    "postprocessing": "^6.39.5",
    "ws": "^8.22.0",
    "yauzl": "3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@playwright/test": "1.56.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yazl": "3.3.1",
    "zustand": "^5.0.15"
  }
}
